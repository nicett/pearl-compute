// Pearl Compute — 数据库 schema
// 设计文档: docs/v1-platform-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────── 用户 ─────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  username      String    @unique
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String
  locale        String    @default("en")
  theme         String    @default("system")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  config        UserConfig?
  miners        MinerBinding[]
  alerts        AlertRule[]
  notifications Notification[]

  @@index([email])
}

// ───────── 计算器配置（一对一） ─────────

model UserConfig {
  userId           String  @id @db.Uuid
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  gpuCount         Float   @default(1)
  cardPrice        Float   @default(2800)
  residualValue    Float   @default(2000)
  powerCons        Float   @default(150)
  gpuHashrate      Float   @default(70)
  poolFee          Float   @default(3)
  electricityPrice Float   @default(0.7)
  selectedPoolSlug String?
  priceSource      String  @default("Pearl OTC")
  currency         String  @default("USD")

  updatedAt        DateTime @updatedAt
}

// ───────── 矿工绑定（一个用户可绑多个矿池×多个地址） ─────────

model MinerBinding {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  poolSlug   String
  walletAddr String
  label      String?
  createdAt  DateTime @default(now())

  snapshots  MinerSnapshot[]

  @@unique([userId, poolSlug, walletAddr])
  @@index([poolSlug])
}

// ───────── 挖矿数据快照（时序） ─────────

model MinerSnapshot {
  id            BigInt       @id @default(autoincrement())
  bindingId     String       @db.Uuid
  binding       MinerBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  snapshotAt    DateTime
  hashrateHps   BigInt?
  balanceGrains BigInt?
  paid24hGrains BigInt?
  workerCount   Int?
  rawJson       Json

  @@index([bindingId, snapshotAt(sort: Desc)])
}

// ───────── 价格预警 ─────────

model AlertRule {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        AlertType
  threshold   Float
  priceSource String?
  enabled     Boolean   @default(true)
  cooldownMin Int       @default(60)
  lastFiredAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled, type])
}

enum AlertType {
  PRICE_ABOVE
  PRICE_BELOW
  SHUTDOWN_NEAR
}

// ───────── 通知记录 ─────────

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  channel   String
  subject   String
  body      String
  meta      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
}
