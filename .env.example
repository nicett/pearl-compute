# Pearl Compute 环境变量样例
# 复制为 .env.local（开发）或 .env（生产），按需修改
# .env.local 已在 .gitignore，不会提交

# ── 数据库（PostgreSQL） ──
# 本地开发：指向局域网内 Docker PostgreSQL
DATABASE_URL="postgresql://pearl:pearl_dev_2026@192.168.1.167:5432/pearl_compute?schema=public"
DIRECT_URL="postgresql://pearl:pearl_dev_2026@192.168.1.167:5432/pearl_compute?schema=public"
# 生产（Supabase ap-southeast-1）：DATABASE_URL 是 pooler，DIRECT_URL 是 5432 直连
# DATABASE_URL="postgresql://postgres.xxx:pwd@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.xxx:pwd@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── 缓存（Redis） ──
# 本地不启 Redis 时留空，cache 模块会自动降级
REDIS_URL="redis://127.0.0.1:6379"

# ── Auth.js v5 ──
# 必须设置：用于签 JWT
# 生成方法：openssl rand -base64 32   或   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# 生产必须改成真实域名，dev 留空即可（Auth.js 自动读 host header）
AUTH_URL=""

# ── 邮件（v1 Sprint 4 才用到） ──
# RESEND_API_KEY=""
