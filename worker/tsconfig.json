{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "isolatedModules": false,
    "incremental": false,
    "jsx": "preserve"
  },
  "include": ["**/*.ts", "../app/lib/db.ts", "../app/lib/pools/**/*.ts", "../app/lib/validators/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
